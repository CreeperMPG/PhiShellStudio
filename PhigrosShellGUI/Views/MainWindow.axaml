<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PhigrosShellGUI.ViewModels"
        xmlns:views="using:PhigrosShellGUI.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="PhigrosShellGUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PhiShell Studio"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="Blur"
        ExtendClientAreaToDecorationsHint="False"
        Background="{DynamicResource SystemChromeMediumLowColor}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- 所有实际内容委托给 AppView -->
    <views:AppView DataContext="{Binding}" />

</Window>
